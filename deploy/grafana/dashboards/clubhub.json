            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"clubhub-api\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
